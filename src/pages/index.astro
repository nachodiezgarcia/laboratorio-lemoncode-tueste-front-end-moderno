---
import "../styles/global.css";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/webp" href="/coffe-logo.webp" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Esta es la pagina de Tueste, que seleccionamos granos de café de origen, los tostamos y llegan a tu casa cada mes">
		<title>Tueste Coffee</title>

		<!-- Para evitar el parpadeo :) -->
		<script is:inline>
			const savedTheme = localStorage.getItem("theme");
			const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
			if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
				document.documentElement.classList.add("dark");
			}
		</script>
	</head>
	<body>
		<!-- data-open = menú móvil abierto O cerrado :) -->
		<header class="coffe-header group">
			<nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4">
				<a href="/" class="coffe-logo flex items-center gap-2 focus-visible:ring-2 focus-visible:ring-accent/40">
					<img src="/coffe-logo.webp" alt="Taza de café, logo de Tueste" class="h-10 w-10" />
					<span class="font-heading text-h3 font-bold">Tueste</span>
				</a>

				<!-- (movil) hidden hasta abrir :) -->
				<ul class="coffe-links order-last hidden w-full flex-col gap-2 font-nav text-nav font-medium uppercase tracking-wide group-data-open:flex md:order-0 md:flex md:w-auto md:flex-row md:gap-6">
					<li><a href="#coffe-cards-section" class="menu-link">Cafés</a></li>
					<li><a href="#coffe-plans-section" class="menu-link">Planes</a></li>
					<li><a href="#coffe-faq-section" class="menu-link">FAQ</a></li>
				</ul>

				<div class="flex w-full items-center justify-between md:w-auto md:gap-12">
					<button type="button" class="menu-toggle cursor-pointer rounded-3xl bg-background p-3 focus-visible:ring-2 focus-visible:ring-accent hover:bg-background-hover md:hidden" aria-label="Abrir menú" aria-expanded="false">
						<img src="/menu.svg" alt="" class="size-6 group-data-open:hidden dark:invert" />
						<img src="/menu-open.svg" alt="" class="hidden size-6 group-data-open:block dark:invert" />
					</button>
					<button type="button" class="theme-toggle cursor-pointer text-2xl bg-background focus-visible:ring-2 focus-visible:ring-accent hover:bg-background-hover p-2 rounded-3xl" aria-label="Cambiar modo claro / oscuro">
						<span class="dark:hidden">☀️</span>
						<span class="hidden dark:inline">🌙</span>
					</button>
					<a href="#coffe-plans-section" class="cta-button btn btn-primary">Suscríbete</a>
				</div>
			</nav>
		</header>

		<main>
			<section id="coffe-hero-section" class="coffe-hero-section">
				<div class="flex flex-col gap-6">
					<h1>Café recién tostado, en tu puerta cada mes.</h1>
					<p class="text-text-muted max-w-prose">
						Lorem ipsum dolor sit amet consectetur adipisicing elit. Seleccionamos granos de origen y los tostamos la semana del envío.
					</p>
					<div class="flex flex-wrap gap-4">
						<a href="#coffe-plans-section" class="btn btn-primary">Suscríbete</a>
						<a href="#coffe-cards-section" class="btn btn-soft">Ver cafés</a>
					</div>
				</div>
				<picture>
					<source media="(min-width: 768px)" srcset="/coffe-hero.webp" />
					<img src="/coffe-hero-mobile.webp" alt="Granos de café recién tostados" class="aspect-4/3 w-full" />
				</picture>
			</section>
			<section id="coffe-cards-section" class="coffe-cards-section">
				<h2 class="mb-8">Cafés del mes</h2>
				<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					<article class="card">
						<div class="flex justify-between">
							<div>
								<h3>Etiopía</h3>
								<p class="text-text-muted">Notas florales y cítricas.</p>
							</div>
							<img src="/coffe-etiopia.webp" alt="Granos de café de Etiopía" class="size-16 aspect-square rounded-xl object-cover" />
						</div>
						<div class="mt-auto flex justify-between items-baseline-last">
							<p class="font-button font-semibold text-accent">14,90 €</p>
							<a href="#coffe-plans-section" class="btn btn-primary mt-4">Añadir</a>
						</div>
						<div class="absolute inset-0 -z-10 bg-[url('/coffe-etiopia-bg.png')] bg-cover bg-fixed bg-center bg-no-repeat opacity-20"></div>
					</article>
					<article class="card">
						<div class="flex justify-between">
							<div>
								<h3>Colómbia</h3>
								<p class="text-text-muted">Caramelo y chocolate con leche.</p>
							</div>
							<img src="/coffe-colombia.webp" alt="Granos de café de Colómbia" class="size-16 aspect-square rounded-xl object-cover" />
						</div>
						<div class="mt-auto flex justify-between items-baseline-last">
							<p class="font-button font-semibold text-accent">12,90 €</p>
							<a href="#coffe-plans-section" class="btn btn-primary mt-4">Añadir</a>
						</div>
						<div class="absolute inset-0 -z-10 bg-[url('/coffe-colombia-bg.png')] bg-cover bg-fixed bg-center bg-no-repeat opacity-20"></div>
					</article>
					<article class="card">
						<div class="flex justify-between">
							<div>
								<h3>Kenia</h3>
								<p class="text-text-muted">Frutos rojos y acidez brillante.</p>
							</div>
							<img src="/coffe-kenia.webp" alt="Granos de café de Kenia" class="size-16 aspect-square rounded-xl object-cover" />
						</div>
						<div class="mt-auto flex justify-between items-baseline-last">
							<p class="font-button font-semibold text-accent">15,50 €</p>
							<a href="#coffe-plans-section" class="btn btn-primary mt-4">Añadir</a>
						</div>
						<div class="absolute inset-0 -z-10 bg-[url('/coffe-kenia-bg.png')] bg-cover bg-fixed bg-center bg-no-repeat opacity-20"></div>
					</article>
					<article class="card">
						<div class="flex justify-between">
							<div>
								<h3>Nicaragua</h3>
								<p class="text-text-muted">Chocolate suave, caramelo, frutal, mantequilla.</p>
							</div>
							<img src="/coffe-nicaragua.webp" alt="Granos de café de Nicaragua" class="size-16 aspect-square rounded-xl object-cover" />
						</div>
						<div class="mt-auto flex justify-between items-baseline-last">
							<p class="font-button font-semibold text-accent">12,50 €</p>
							<a href="#coffe-plans-section" class="btn btn-primary mt-4">Añadir</a>
						</div>
						<div class="absolute inset-0 -z-10 bg-[url('/coffe-nicaragua-bg.png')] bg-cover bg-fixed bg-center bg-no-repeat opacity-20"></div>
					</article>
					<article class="card">
						<div class="flex justify-between">
							<div>
								<h3>Costa Rica</h3>
								<p class="text-text-muted">Cuerpo medio, acidez baja.</p>
							</div>
							<img src="/coffe-costa-rica.webp" alt="Granos de café de Costa Rica" class="size-16 aspect-square rounded-xl object-cover" />
						</div>
						<div class="mt-auto flex justify-between items-baseline-last">
							<p class="font-button font-semibold text-accent">14,90 €</p>
							<a href="#coffe-plans-section" class="btn btn-primary mt-4">Añadir</a>
						</div>
						<div class="absolute inset-0 -z-10 bg-[url('/coffe-costa-rica-bg.png')] bg-cover bg-fixed bg-center bg-no-repeat opacity-20"></div>
					</article>
					<article class="card">
						<div class="flex justify-between">
							<div>
								<h3>Brasil</h3>
								<p class="text-text-muted">Acidez muy baja y cuerpo medio y cremoso.</p>
							</div>
							<img src="/coffe-brasil.webp" alt="Granos de café de Brasil" class="size-16 aspect-square rounded-xl object-cover" />
						</div>
						<div class="mt-auto flex justify-between items-baseline-last">
							<p class="font-button font-semibold text-accent">15,70 €</p>
							<a href="#coffe-plans-section" class="btn btn-primary mt-4">Añadir</a>
						</div>
						<div class="absolute inset-0 -z-10 bg-[url('/coffe-brasil-bg.png')] bg-cover bg-fixed bg-center bg-no-repeat opacity-20"></div>
					</article>
				</div>
			</section>
			<section id="coffe-steps-section" class="coffe-steps-section">
				<h2 class="sr-only">Cómo funciona</h2>
				<ol class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-12 md:flex-row md:items-center md:justify-between">
					<li class="step">
						<span class="flex h-10 w-10 items-center justify-center rounded-full bg-accent font-button font-semibold text-white">1</span>
						<span class="font-heading text-h3">Eliges</span>
					</li>
					<li class="hidden h-px flex-1 bg-soft md:block" aria-hidden="true"></li>
					<li class="step">
						<span class="flex h-10 w-10 items-center justify-center rounded-full bg-accent font-button font-semibold text-white">2</span>
						<span class="font-heading text-h3">Tostamos</span>
					</li>
					<li class="hidden h-px flex-1 bg-soft md:block" aria-hidden="true"></li>
					<li class="step">
						<span class="flex h-10 w-10 items-center justify-center rounded-full bg-accent font-button font-semibold text-white">3</span>
						<span class="font-heading text-h3">Te llega</span>
					</li>
				</ol>
			</section>
			<section id="coffe-plans-section" class="coffe-plans-section">
				<h2 class="mb-8">Planes</h2>
				<div class="grid items-center gap-6 md:grid-cols-3">
					<article class="plan">
						<h3>Básico</h3>
						<p class="text-text-muted">1 bolsa de 250 g al mes.</p>
						<p class="my-6 font-heading text-h2">12 €</p>
						<a href="#" class="btn btn-soft w-full text-center">Elegir</a>
					</article>
					<article class="plan plan-popular">
						<span class="absolute -top-3 left-1/5 -translate-x-1/2 rounded-full bg-accent px-3 py-1 text-white font-button text-small font-semibold">☕ Popular</span>
						<h3>Estándar</h3>
						<p class="text-text-muted">2 bolsas de 250 g al mes.</p>
						<p class="my-6 font-heading text-h2">22 €</p>
						<a href="#" class="btn btn-primary w-full text-center">Elegir</a>
					</article>

					<article class="plan">
						<h3>Pro</h3>
						<p class="text-text-muted">4 bolsas de 250 g al mes.</p>
						<p class="my-6 font-heading text-h2">40 €</p>
						<a href="#" class="btn btn-soft w-full text-center">Elegir</a>
					</article>
				</div>
			</section>
			<section id="coffe-faq-section" class="coffe-faq-section">
				<h2 class="mb-8">FAQ</h2>
				<div class="coffe-faq flex flex-col gap-3">
					<details class="faq group rounded-xl border border-border bg-surface p-4">
						<!-- Me gusta más así <summary class="cursor-pointer font-bold focus-visible:ring-2 focus-visible:ring-accent">¿Molido o en grano?</summary> -->
						<summary class="flex cursor-pointer items-center justify-between gap-4 font-bold focus-visible:ring-2 focus-visible:ring-accent">
							<span>¿Puedo cancelar cuando quiera?</span>
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 shrink-0 text-accent group-open:rotate-180 motion-safe:transition-transform"><path d="m6 9 6 6 6-6"/></svg>
						</summary>
						<p class="mt-2 text-text-muted">Sí, sin permanencia. Cancelas desde tu cuenta.</p>
					</details>
					<details class="faq group rounded-xl border border-border bg-surface p-4">
						<summary class="flex cursor-pointer items-center justify-between gap-4 font-bold focus-visible:ring-2 focus-visible:ring-accent">
							<span>¿Molido o en grano?</span>
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 shrink-0 text-accent group-open:rotate-180 motion-safe:transition-transform"><path d="m6 9 6 6 6-6"/></svg>
						</summary>
						<p class="mt-2 text-text-muted">Tú eliges al suscribirte y puedes cambiarlo cada mes.</p>
					</details>
					<details class="faq group rounded-xl border border-border bg-surface p-4">
						<summary class="flex cursor-pointer items-center justify-between gap-4 font-bold focus-visible:ring-2 focus-visible:ring-accent">
							<span>¿Cómo pago?</span>
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 shrink-0 text-accent group-open:rotate-180 motion-safe:transition-transform"><path d="m6 9 6 6 6-6"/></svg>
						</summary>
						<p class="mt-2 text-text-muted">Con tarjeta o PayPal, se cobra al hacer cada envío.</p>
					</details>
				</div>
			</section>
		</main>
		<footer class="coffe-footer">
			<div class="mx-auto grid max-w-6xl items-baseline gap-10 px-4 py-12 md:grid-cols-3">
				<div class="footer-links flex flex-col gap-2">
					<span class="font-heading text-h3">Tueste</span>
					<ul class="flex flex-col gap-2">
						<li><a href="#coffe-cards-section" class="text-soft hover:text-white focus-visible:ring-2 focus-visible:ring-accent">Cafés</a></li>
						<li><a href="#coffe-plans-section" class="text-soft hover:text-white focus-visible:ring-2 focus-visible:ring-accent">Planes</a></li>
						<li><a href="#coffe-faq-section" class="text-soft hover:text-white focus-visible:ring-2 focus-visible:ring-accent">FAQ</a></li>
					</ul>
				</div>

				<div class="footer-social flex flex-col gap-2">
					<span class="font-bold">Síguenos</span>
					<ul class="flex flex-col gap-2">
						<li><a target="_blank" href="https://www.instagram.com/" class="text-soft hover:text-white focus-visible:ring-2 focus-visible:ring-accent">Instagram</a></li>
						<li><a target="_blank" href="https://www.tiktok.com/es/" class="text-soft hover:text-white focus-visible:ring-2 focus-visible:ring-accent">TikTok</a></li>
					</ul>
				</div>

				<form class="footer-newsletter flex flex-col gap-3">
					<label for="email" class="font-bold">Newsletter</label>
					<div class="flex gap-2">
						<input
							id="email"
							type="email"
							placeholder="tu@email.com"
							class="min-w-0 flex-1 rounded-full bg-white/10 px-4 py-2 text-cream focus-visible:ring-2 focus-visible:ring-accent placeholder:text-soft/70"
						/>
						<button type="submit" class="btn btn-primary">OK</button>
					</div>
				</form>
			</div>
			<p class="border-t border-white/10 py-4 text-center text-small text-soft">© 2026 Tueste Coffee</p>
		</footer>

		<script>
			const themeToggle = document.querySelector(".theme-toggle");
			themeToggle?.addEventListener("click", () => {
				const isDark = document.documentElement.classList.toggle("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
			});

			// Menú móvil: abrir/cerrar poniendo o quitando data-open en el header
			const header = document.querySelector(".coffe-header");
			const menuToggle = document.querySelector(".menu-toggle");

			function setMenu(open: boolean) {
				header?.toggleAttribute("data-open", open);
				menuToggle?.setAttribute("aria-expanded", String(open));
			}

			// Pinchar en el botón: abre si está cerrado, cierra si está abierto
			menuToggle?.addEventListener("click", () => {
				setMenu(!header?.hasAttribute("data-open"));
			});

			// Pinchar fuera del header o en un enlace del menú: cierra
			document.addEventListener("click", (event) => {
				const target = event.target as HTMLElement;
				if (!header?.contains(target) || target.closest(".menu-link")) {
					setMenu(false);
				}
			});
		</script>
	</body>
</html>
